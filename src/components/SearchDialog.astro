---
import Search from './Search.astro';
---

<dialog class="search-dialog" id="buscar-dialogo" aria-labelledby="buscar-dialogo-label">
  <div class="search-dialog-inner">
    <form class="search-dialog-close" method="dialog">
      <button type="submit">Cerrar <kbd class="search-dialog-esc">Esc</kbd></button>
    </form>
    <Search id="buscar-dialogo" autofocus />
  </div>
</dialog>

<style>
  .search-dialog {
    inline-size: min(44rem, 100% - 2 * var(--page-margin));
    max-inline-size: none;
    max-block-size: min(80vh, 48rem);
    margin-block-start: 10vh;
    padding: 0;
    border: 1px solid var(--foreground);
    background: var(--background);
    color: var(--foreground);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .search-dialog::backdrop {
    background: rgb(17 16 14 / 0.6);
  }

  .search-dialog-inner {
    position: relative;
    padding: var(--space-6);
  }

  /* Close shares the label's line, at the trailing edge. */
  .search-dialog-close {
    position: absolute;
    inset-block-start: calc(var(--space-6) - var(--space-3));
    inset-inline-end: calc(var(--space-6) - var(--space-3));
  }

  .search-dialog-close button {
    min-block-size: 2.75rem;
    padding-inline: var(--space-3);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--font-ui);
    text-decoration: underline;
    text-decoration-color: var(--edge);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .search-dialog-esc {
    display: none;
    margin-inline-start: var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--font-meta);
    color: var(--muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .search-dialog-esc {
      display: inline;
    }
  }

  @media (max-width: 40rem) {
    .search-dialog {
      inline-size: 100%;
      max-block-size: none;
      block-size: 100%;
      margin: 0;
      border: 0;
    }

    .search-dialog-inner {
      padding: var(--space-6) var(--page-margin);
    }

    .search-dialog-close {
      inset-inline-end: calc(var(--page-margin) - var(--space-3));
    }
  }

  :global(html:has(dialog:modal)) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#buscar-dialogo');
  const pageInput = document.querySelector<HTMLInputElement>('[data-search-sync-url] input');

  function open() {
    // On /buscar/ the field is already on the page: go to it instead.
    if (pageInput) {
      pageInput.focus();
      pageInput.select();
      return;
    }
    if (!dialog || dialog.open) return;
    dialog.showModal();
  }

  const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);

  for (const trigger of document.querySelectorAll<HTMLButtonElement>('[data-search-open]')) {
    trigger.hidden = false;
    trigger.addEventListener('click', open);
  }

  if (isMac) {
    for (const hint of document.querySelectorAll('[data-search-shortcut]')) hint.textContent = '⌘ K';
  }

  document.addEventListener('keydown', (event) => {
    if (event.key.toLowerCase() !== 'k' || !(event.metaKey || event.ctrlKey) || event.altKey || event.shiftKey) return;
    event.preventDefault();
    if (dialog?.open) dialog.close();
    else open();
  });

  // Backdrop click closes, but not a drag that started inside the dialog.
  let pressedOnBackdrop = false;
  dialog?.addEventListener('pointerdown', (event) => {
    pressedOnBackdrop = event.target === dialog;
  });
  dialog?.addEventListener('click', (event) => {
    if (pressedOnBackdrop && event.target === dialog) dialog.close();
    pressedOnBackdrop = false;
  });
</script>

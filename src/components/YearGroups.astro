---
import EntryList from './EntryList.astro';
import { groupByYear, type Escrito } from '../lib/escritos';

interface Props {
  entries: Escrito[];
}

const { entries } = Astro.props;
const years = groupByYear(entries);
---

{years.map(([year, yearEntries]) => (
  <section class="subgrid year" aria-labelledby={`y${year}`}>
    <h2 class="col-context year-label" id={`y${year}`}>{year}</h2>
    <EntryList class="col-content" entries={yearEntries} level={3} />
  </section>
))}

<style>
  .year {
    row-gap: var(--space-5);
  }

  .year + .year {
    margin-block-start: var(--space-8);
  }

  .year-label {
    font-size: var(--font-ui);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  @media (min-width: 56rem) {
    .year-label {
      position: sticky;
      inset-block-start: var(--space-6);
      align-self: start;
      /* Optical: sit on the first title's cap height. */
      padding-block-start: 0.35rem;
    }
  }
</style>

---
import EntryList from './EntryList.astro';
import { groupByYear, type Escrito, type Tema } from '../lib/escritos';

interface Props {
  entries: Escrito[];
  /** Heading level of the year labels; entry titles sit one level below. */
  level: 2 | 3;
  temas?: Map<string, Tema>;
}

const { entries, level, temas } = Astro.props;
const Heading = `h${level}` as const;
const years = groupByYear(entries);
const idPrefix = `y${level}`;
---

{years.map(([year, yearEntries]) => (
  <section class="subgrid year" aria-labelledby={`${idPrefix}-${year}`}>
    <Heading class="col-context year-label" id={`${idPrefix}-${year}`}>{year}</Heading>
    <EntryList class="col-content" entries={yearEntries} level={(level + 1) as 3 | 4} temas={temas} />
  </section>
))}

<style>
  .year {
    row-gap: var(--space-5);
  }

  .year + .year {
    margin-block-start: var(--space-8);
  }

  .year-label {
    font-size: var(--font-ui);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  @media (min-width: 56rem) {
    .year-label {
      position: sticky;
      inset-block-start: var(--space-6);
      align-self: start;
      /* Optical: sit on the first title's cap height. */
      padding-block-start: 0.35rem;
    }
  }
</style>

---
// Title block for inner pages: title on the reading axis, context in the left column.
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="grid page-intro">
  <h1 class="col-content page-title">{title}</h1>
  {lead && <p class="col-content lead">{lead}</p>}
  {Astro.slots.has('default') && (
    <div class="col-context meta page-context">
      <slot />
    </div>
  )}
</header>

<style>
  .page-intro {
    row-gap: var(--space-5);
    padding-block: var(--space-7) var(--space-8);
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: var(--font-title);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lead {
    color: var(--muted);
    max-inline-size: var(--measure);
  }

  @media (min-width: 56rem) {
    .page-title {
      grid-row: 1;
    }

    /* Context sits beside the title, resting on its last line. */
    .page-context {
      grid-row: 1;
      align-self: last baseline;
    }
  }
</style>

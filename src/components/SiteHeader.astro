---
const path = Astro.url.pathname.replace(/\/?$/, '/');

const items = [
  { href: '/sobre-mi/', label: 'Sobre mí' },
  { href: '/rss.xml', label: 'RSS', prefetch: false },
];
---

<header class="grid site-header">
  <p class="wordmark">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Postdata</a>
  </p>

  <nav class="site-nav" aria-label="Principal">
    <ul role="list">
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined} data-astro-prefetch={item.prefetch === false ? 'false' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    align-items: center;
    padding-block: var(--space-5);
    font-size: var(--font-ui);
  }

  .wordmark {
    grid-column: 1 / 7;
    grid-row: 1;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .site-nav {
    grid-column: 7 / -1;
    grid-row: 1;
    justify-self: end;
  }

  /* The nav starts on the reading axis, like the content below it. */
  @media (min-width: 56rem) {
    .wordmark {
      grid-column: 1 / span 4;
    }

    .site-nav {
      grid-column: 5 / -1;
      justify-self: start;
    }
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-5);
    row-gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .site-nav a,
  .wordmark a {
    display: inline-block;
    padding-block: var(--space-2);
  }

  /* Current location: a heavy underline in ink, never colour alone. */
  a[aria-current]:not([aria-current="false"]) {
    text-decoration-thickness: 3px;
    text-decoration-color: currentColor;
  }
</style>

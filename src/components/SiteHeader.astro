---
// Compact header for inner pages. The home page carries its own masthead.
const isHome = Astro.url.pathname === '/';
---

<header class="grid site-header">
  <p class="col-context wordmark">
    <a href="/" aria-current={isHome ? 'page' : undefined}>Postdata</a>
  </p>
</header>

<style>
  .site-header {
    padding-block: var(--space-6) var(--space-8);
  }

  .wordmark {
    font-size: var(--font-ui);
    font-weight: 600;
    letter-spacing: 0.01em;
  }
</style>

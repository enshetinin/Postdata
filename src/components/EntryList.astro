---
import {
  escritoUrl,
  readingMinutes,
  formatDayMonth,
  formatDate,
  isoDate,
  type Escrito,
} from '../lib/escritos';

interface Props {
  entries: Escrito[];
  /** Heading level of each entry title. */
  level: 3 | 4;
  /** compact: title and date. full: adds description and reading time. */
  variant?: 'full' | 'compact';
  /** Show the year in the date (when the list is not grouped by year). */
  withYear?: boolean;
  class?: string;
}

const { entries, level, variant = 'full', withYear = false, class: className } = Astro.props;
const Heading = `h${level}` as const;
const format = withYear ? formatDate : formatDayMonth;
---

<ol class:list={['entries', variant, className]} role="list">
  {entries.map((entry) => (
    <li>
      <article class="entry">
        <Heading class="entry-title">
          <a href={escritoUrl(entry)}>{entry.data.title}</a>
        </Heading>
        {variant === 'full' && <p class="entry-description">{entry.data.description}</p>}
        <p class="meta">
          <time datetime={isoDate(entry.data.date)}>{format(entry.data.date)}</time>
          {variant === 'full' && (
            <>
              <span aria-hidden="true"> · </span>
              {readingMinutes(entry.body)} min de lectura
            </>
          )}
        </p>
      </article>
    </li>
  ))}
</ol>

<style>
  .entries {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .full {
    row-gap: var(--space-7);
  }

  .compact {
    row-gap: var(--space-5);
  }

  .entry {
    display: grid;
    row-gap: var(--space-2);
    max-inline-size: var(--measure);
  }

  .compact .entry {
    row-gap: var(--space-1);
  }

  .entry-title {
    font-family: var(--font-serif);
    font-size: var(--font-entry);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .compact .entry-title {
    font-size: var(--font-entry-compact);
    line-height: 1.25;
  }

  .entry-title a {
    text-underline-offset: 0.18em;
  }

  .entry-description {
    color: var(--muted);
    text-wrap: pretty;
  }
</style>

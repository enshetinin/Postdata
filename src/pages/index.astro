---
import Base from '../layouts/Base.astro';
import YearGroups from '../components/YearGroups.astro';
import { getEscritos, countLabel } from '../lib/escritos';

const escritos = await getEscritos();
const since = escritos.at(-1)?.data.date.getUTCFullYear() ?? new Date().getFullYear();
---

<Base>
  <div class="grid masthead">
    <h1 class="title">Postdata</h1>
    <p class="col-context meta masthead-meta">
      Blog personal<br />
      En español, desde {since}
    </p>
    <p class="col-content lead intro">
      Una posdata es lo que se añade al final, cuando lo importante ya parece dicho.
      Aquí escribo sobre diseño, software y las cosas que se quedan fuera.
    </p>
  </div>

  <section class="grid escritos" aria-labelledby="escritos-titulo">
    <div class="col-context escritos-heading">
      <h2 id="escritos-titulo">Escritos</h2>
      {escritos.length > 0 && <p class="meta">{countLabel(escritos.length)}</p>}
    </div>

    {escritos.length === 0 && <p class="col-content empty">Todavía no hay nada publicado.</p>}

    <YearGroups entries={escritos} />
  </section>
</Base>

<style>
  /* Masthead: the one identity moment. Large Newsreader, then the grid takes over. */
  .masthead {
    row-gap: var(--space-6);
    padding-block: clamp(var(--space-7), 9vw, var(--space-9)) var(--space-9);
  }

  .title {
    font-family: var(--font-serif);
    font-size: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.025em;
    /* Optical alignment of the large P with the grid edge. */
    margin-inline-start: -0.04em;
  }

  .masthead-meta {
    padding-block-start: 0.45em;
  }

  .intro {
    max-inline-size: 34ch;
  }

  .escritos-heading {
    display: grid;
    row-gap: var(--space-1);
    margin-block-end: var(--space-7);
  }

  .escritos-heading h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-ui);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* Signal as notation: a single mark where the writing begins. */
  .escritos-heading h2::before {
    content: "";
    inline-size: 0.625rem;
    block-size: 0.625rem;
    background: var(--signal);
    flex: none;
  }

  .empty {
    color: var(--muted);
  }
</style>

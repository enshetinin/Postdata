---
import Base from '../layouts/Base.astro';
import EntryList from '../components/EntryList.astro';
import { getEscritos, getGrupos, temaUrl, countLabel } from '../lib/escritos';

const PER_TEMA = 3;

const [escritos, grupos] = await Promise.all([getEscritos(), getGrupos()]);
const since = escritos.at(-1)?.data.date.getUTCFullYear() ?? new Date().getFullYear();
const temasLabel = grupos.length === 1 ? '1 tema' : `${grupos.length} temas`;
---

<Base>
  <div class="grid masthead">
    <h1 class="title">Postdata</h1>
    <p class="col-context meta masthead-meta">
      Blog personal<br />
      En español, desde {since}
    </p>
    <p class="col-content lead intro">
      Una posdata es lo que se añade al final, cuando lo importante ya parece dicho.
      Aquí escribo sobre diseño, software y las cosas que se quedan fuera.
    </p>
  </div>

  <section class="grid temas" aria-labelledby="temas-titulo">
    <div class="col-context temas-heading">
      <h2 id="temas-titulo">Por temas</h2>
      <p class="meta">{countLabel(escritos.length)} en {temasLabel}</p>
    </div>

    {grupos.length === 0 && <p class="col-content empty">Todavía no hay nada publicado.</p>}

    {grupos.map(({ tema, escritos: entries }) => (
      <section class="subgrid tema" aria-labelledby={`tema-${tema.id}`}>
        <div class="col-context tema-context">
          <h3 class="tema-name" id={`tema-${tema.id}`}>
            <a href={temaUrl(tema.id)}>{tema.data.nombre}</a>
          </h3>
          <p class="meta">{tema.data.descripcion}</p>
        </div>
        <div class="col-content tema-entries">
          <EntryList entries={entries.slice(0, PER_TEMA)} level={4} variant="compact" withYear />
          {entries.length > PER_TEMA && (
            <p class="more">
              <a href={temaUrl(tema.id)}>Los {entries.length} textos de {tema.data.nombre}</a>
            </p>
          )}
        </div>
      </section>
    ))}

    {escritos.length > 0 && (
      <p class="col-content archive-link">
        Todo, por fecha, en el <a href="/archivo/">archivo</a>.
      </p>
    )}
  </section>
</Base>

<style>
  /* Masthead: the one identity moment. Large Newsreader, then the grid takes over. */
  .masthead {
    row-gap: var(--space-6);
    padding-block: clamp(var(--space-7), 9vw, var(--space-9)) var(--space-9);
  }

  .title {
    font-family: var(--font-serif);
    font-size: var(--font-display);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.025em;
    /* Optical alignment of the large P with the grid edge. */
    margin-inline-start: -0.04em;
  }

  .masthead-meta {
    padding-block-start: 0.45em;
  }

  .intro {
    max-inline-size: 34ch;
  }

  .temas {
    row-gap: var(--space-8);
  }

  .temas-heading {
    margin-block-end: calc(var(--space-5) - var(--space-8));
  }

  .temas-heading h2 {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-ui);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* Signal as notation: a single mark where the writing begins. */
  .temas-heading h2::before {
    content: "";
    inline-size: 0.625rem;
    block-size: 0.625rem;
    background: var(--signal);
    flex: none;
  }

  .tema {
    row-gap: var(--space-4);
  }

  .tema-context {
    display: grid;
    row-gap: var(--space-1);
    align-content: start;
    max-inline-size: 28ch;
  }

  .tema-name {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .more {
    margin-block-start: var(--space-4);
    font-size: var(--font-ui);
  }

  .archive-link,
  .empty {
    color: var(--muted);
  }

  .archive-link {
    font-family: var(--font-serif);
    font-size: var(--font-lead);
  }

  @media (min-width: 56rem) {
    /* Tema name rests on the first title's cap height. */
    .tema-context {
      padding-block-start: 0.2rem;
    }
  }
</style>

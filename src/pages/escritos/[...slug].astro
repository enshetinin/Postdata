---
// Provisional article page: enough for the index links to resolve.
// The reading surface gets its own design pass later.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { getEscritos, readingMinutes, formatDate, isoDate, type Escrito } from '../../lib/escritos';

export async function getStaticPaths() {
  const escritos = await getEscritos();
  return escritos.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Escrito };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <SiteHeader slot="header" />
  <article class="grid article">
    <header class="col-content article-header">
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>
    <aside class="col-context meta article-meta" aria-label="Datos del texto">
      <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time><br />
      {readingMinutes(entry.body)} min de lectura
    </aside>
    <div class="col-content prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .article {
    row-gap: var(--space-7);
  }

  .article-header {
    display: grid;
    row-gap: var(--space-5);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: var(--font-lead);
    line-height: 1.4;
    color: var(--muted);
    max-inline-size: var(--measure);
  }

  @media (min-width: 56rem) {
    .article-header {
      grid-row: 1;
    }

    .article-meta {
      grid-row: 2;
      align-self: start;
      position: sticky;
      inset-block-start: var(--space-6);
    }

    .prose {
      grid-row: 2;
    }
  }

  .prose {
    max-inline-size: var(--measure);
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.6;
  }

  .prose :global(* + *) {
    margin-block-start: 1.1em;
  }

  .prose :global(h2) {
    margin-block-start: 2.2em;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .prose :global(h2 + *) {
    margin-block-start: 0.6em;
  }

  .prose :global(:is(ul, ol)) {
    padding-inline-start: 1.25em;
  }

  .prose :global(blockquote) {
    padding-inline-start: 1em;
    border-inline-start: 2px solid var(--foreground);
    font-style: italic;
  }

  .prose :global(:not(pre) > code) {
    font-size: 0.85em;
    padding: 0.1em 0.3em;
    background: var(--surface);
  }

  .prose :global(pre) {
    padding: var(--space-4) var(--space-5);
    overflow-x: auto;
    background: var(--surface);
    font-size: 0.8125rem;
    line-height: 1.6;
    tab-size: 2;
  }
</style>

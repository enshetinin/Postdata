---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getEscritos, readingMinutes, formatDate, isoDate, type Escrito } from '../../lib/escritos';

export async function getStaticPaths() {
  const escritos = await getEscritos();
  return escritos.map((entry) => {
    const related = escritos.filter((e) => e.id !== entry.id).slice(0, 3);
    return { params: { slug: entry.id }, props: { entry, related } };
  });
}

const { entry, related } = Astro.props as { entry: Escrito; related: Escrito[] };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="grid article">
    <header class="col-content article-header">
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>

    <aside class="col-context meta article-meta" aria-label="Datos del texto">
      <ul role="list">
        <li><time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time></li>
        <li>{readingMinutes(entry.body)} min de lectura</li>
      </ul>
    </aside>

    <div class="col-content prose">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="grid related" aria-labelledby="mas-titulo">
      <div class="col-context related-heading">
        <h2 id="mas-titulo">Más textos</h2>
        <p class="meta"><a href="/">Todos, en la portada</a></p>
      </div>
      <EntryList class="col-content" entries={related} level={3} variant="compact" withYear />
    </section>
  )}
</Base>

<style>
  .article {
    padding-block-start: var(--space-7);
  }

  .article-header {
    display: grid;
    row-gap: var(--space-5);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: var(--font-title);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lead {
    color: var(--muted);
    max-inline-size: var(--measure);
  }

  /* In one column the data belongs to the title: close to it, far from the text. */
  .article-meta {
    margin-block: var(--space-5) var(--space-7);
  }

  .article-meta ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-5);
    row-gap: var(--space-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .related {
    row-gap: var(--space-5);
    margin-block-start: var(--space-9);
  }

  .related-heading {
    display: grid;
    row-gap: var(--space-1);
    align-content: start;
  }

  .related-heading h2 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (min-width: 56rem) {
    .article {
      row-gap: var(--space-7);
    }

    .article-header {
      grid-row: 1;
    }

    .article-meta {
      grid-row: 2;
      align-self: start;
      position: sticky;
      inset-block-start: var(--space-6);
      margin-block: 0;
      padding-block-start: 0.35rem;
    }

    .article-meta ul {
      flex-direction: column;
    }

    .prose {
      grid-row: 2;
    }
  }
</style>

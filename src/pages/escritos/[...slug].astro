---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { getEscritos, getTemas, readingMinutes, formatDate, isoDate, temaUrl, type Escrito, type Tema } from '../../lib/escritos';

export async function getStaticPaths() {
  const [escritos, temas] = await Promise.all([getEscritos(), getTemas()]);
  return escritos.map((entry) => {
    const tema = temas.get(entry.data.tema.id)!;
    const related = escritos.filter((e) => e.data.tema.id === tema.id && e.id !== entry.id).slice(0, 3);
    return { params: { slug: entry.id }, props: { entry, tema, related } };
  });
}

const { entry, tema, related } = Astro.props as { entry: Escrito; tema: Tema; related: Escrito[] };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="grid article" data-pagefind-body>
    <header class="col-content article-header">
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>

    <!-- Not indexed as text; its values still become search metadata. -->
    <aside class="col-context meta article-meta" aria-label="Datos del texto" data-pagefind-ignore>
      <a href={temaUrl(tema.id)} data-pagefind-meta="tema">{tema.data.nombre}</a><br />
      <time datetime={isoDate(entry.data.date)} data-pagefind-meta="fecha">{formatDate(entry.data.date)}</time><br />
      {readingMinutes(entry.body)} min de lectura
    </aside>

    <div class="col-content prose">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="grid related" aria-labelledby="mas-titulo">
      <div class="col-context related-heading">
        <h2 id="mas-titulo">Más en {tema.data.nombre}</h2>
        <p class="meta"><a href={temaUrl(tema.id)}>Todo el tema</a></p>
      </div>
      <EntryList class="col-content" entries={related} level={3} variant="compact" withYear />
    </section>
  )}
</Base>

<style>
  .article {
    row-gap: var(--space-7);
    padding-block-start: var(--space-7);
  }

  .article-header {
    display: grid;
    row-gap: var(--space-5);
  }

  h1 {
    font-family: var(--font-serif);
    font-size: var(--font-title);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lead {
    color: var(--muted);
    max-inline-size: var(--measure);
  }

  .related {
    row-gap: var(--space-5);
    margin-block-start: var(--space-9);
  }

  .related-heading {
    display: grid;
    row-gap: var(--space-1);
    align-content: start;
  }

  .related-heading h2 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (min-width: 56rem) {
    .article-header {
      grid-row: 1;
    }

    .article-meta {
      grid-row: 2;
      align-self: start;
      position: sticky;
      inset-block-start: var(--space-6);
      padding-block-start: 0.35rem;
    }

    .prose {
      grid-row: 2;
    }
  }
</style>

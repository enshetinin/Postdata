---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Search from '../components/Search.astro';
---

<Base title="Buscar" description="Busca en los escritos de Postdata.">
  <PageIntro title="Buscar" />

  <div class="grid">
    <div class="col-content search-page">
      <Search id="buscar-pagina" syncUrl autofocus />
      <noscript>
        <p class="noscript">
          La búsqueda necesita JavaScript. Mientras tanto, puedes recorrer los <a href="/temas/">temas</a> o el
          <a href="/archivo/">archivo</a>.
        </p>
      </noscript>
    </div>
  </div>
</Base>

<style>
  .search-page {
    max-inline-size: var(--measure);
  }

  .noscript {
    margin-block-start: var(--space-5);
  }
</style>

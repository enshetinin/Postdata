---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import { getGrupos, temaUrl, countLabel } from '../../lib/escritos';

const grupos = await getGrupos();
---

<Base title="Temas" description="Los escritos de Postdata agrupados por tema.">
  <PageIntro title="Temas" lead="Cada texto pertenece a un tema. Empieza por el que te interese." />

  <ul class="grid temas" role="list">
    {grupos.map(({ tema, escritos }) => (
      <li class="subgrid tema">
        <p class="col-context meta count">{countLabel(escritos.length)}</p>
        <div class="col-content">
          <h2 class="tema-name"><a href={temaUrl(tema.id)}>{tema.data.nombre}</a></h2>
          <p class="tema-description">{tema.data.descripcion}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>

<style>
  .temas {
    row-gap: var(--space-7);
    margin-block: 0;
    list-style: none;
  }

  .tema {
    row-gap: var(--space-1);
  }

  .tema-name {
    font-family: var(--font-serif);
    font-size: var(--font-entry);
    font-weight: 400;
    line-height: 1.15;
  }

  .tema-name a {
    text-underline-offset: 0.18em;
  }

  .tema-description {
    margin-block-start: var(--space-2);
    max-inline-size: var(--measure);
    color: var(--muted);
  }

  @media (min-width: 56rem) {
    .count {
      padding-block-start: 0.6rem;
    }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import YearGroups from '../../components/YearGroups.astro';
import { getGrupos, countLabel, type Grupo } from '../../lib/escritos';

export async function getStaticPaths() {
  const grupos = await getGrupos();
  return grupos.map((grupo) => ({ params: { tema: grupo.tema.id }, props: grupo }));
}

const { tema, escritos } = Astro.props as Grupo;
---

<Base title={tema.data.nombre} description={tema.data.descripcion}>
  <PageIntro title={tema.data.nombre} lead={tema.data.descripcion}>
    <a href="/temas/">Temas</a><br />
    {countLabel(escritos.length)}
  </PageIntro>

  <div class="grid">
    <YearGroups entries={escritos} level={2} />
  </div>
</Base>
